// morph 的 Prisma 体系里，这个产品只需要"信封 + patch 日志"两张表。
// 业务模型（Project v1.0）始终是 src/domain/project/schema.ts，不落成关系表。
// 迁移时：prisma migrate dev，然后把 FileProjectStore 换成 PrismaProjectStore。

model Project {
  id        String            @id
  ownerId   String
  name      String
  doc       Json
  revision  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  revisions ProjectRevision[]

  @@index([ownerId, updatedAt])
  @@map("film_project")
}

model ProjectRevision {
  id        String   @id @default(cuid())
  projectId String
  revision  Int
  ops       Json
  actorId   String
  message   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, revision])
  @@index([projectId, createdAt])
  @@map("film_project_revision")
}
